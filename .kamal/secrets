# Kamal secrets — each line evaluated independently (no shell state carries over).
# Use grep for plain .env-derived values.

KAMAL_REGISTRY_PASSWORD=$(grep '^KAMAL_REGISTRY_PASSWORD=' .env | cut -d= -f2-)
RAILS_MASTER_KEY=$(cat config/master.key)
POSTGRES_PASSWORD=$(grep '^POSTGRES_PASSWORD=' .env | cut -d= -f2-)
DATABASE_URLS=$(ruby -rcgi -e 'password = CGI.escape(ARGV.fetch(0)); user = "contextqmd_registry"; host = "contextqmd_registry-db"; dbs = %w[contextqmd_registry_production contextqmd_registry_production_cache contextqmd_registry_production_queue contextqmd_registry_production_cable contextqmd_registry_production_analytics]; print dbs.map { |db| "postgres://#{user}:#{password}@#{host}/#{db}" }.join(",")' "$(grep '^POSTGRES_PASSWORD=' .env | cut -d= -f2-)")
CLOUDFLARE_R2_ACCESS_KEY_ID=$(grep '^CLOUDFLARE_R2_ACCESS_KEY_ID=' .env | cut -d= -f2-)
CLOUDFLARE_R2_SECRET_ACCESS_KEY=$(grep '^CLOUDFLARE_R2_SECRET_ACCESS_KEY=' .env | cut -d= -f2-)
GOOGLE_CLIENT_ID=$(grep '^GOOGLE_CLIENT_ID=' .env | cut -d= -f2-)
GOOGLE_CLIENT_SECRET=$(grep '^GOOGLE_CLIENT_SECRET=' .env | cut -d= -f2-)
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=$(grep '^GOOGLE_SEARCH_CONSOLE_CLIENT_ID=' .env | cut -d= -f2-)
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=$(grep '^GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=' .env | cut -d= -f2-)

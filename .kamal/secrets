# Kamal secrets — each line evaluated independently (no shell state carries over).
# Use grep from .env for each secret.

KAMAL_REGISTRY_PASSWORD=$(grep '^KAMAL_REGISTRY_PASSWORD=' .env | cut -d= -f2-)
RAILS_MASTER_KEY=$(cat config/master.key)
POSTGRES_PASSWORD=$(ruby -e 'key = ARGV.fetch(0); line = File.foreach(".env").find { |entry| entry.start_with?("#{key}=") }; value = line.to_s.split("=", 2).last.to_s.strip; if (value.start_with?("\"") && value.end_with?("\"")) || (value.start_with?("'") && value.end_with?("'")); value = value[1...-1]; end; print value' POSTGRES_PASSWORD)
DATABASE_URLS=$(ruby -rcgi -e 'key = "POSTGRES_PASSWORD"; line = File.foreach(".env").find { |entry| entry.start_with?("#{key}=") }; password = line.to_s.split("=", 2).last.to_s.strip; if (password.start_with?("\"") && password.end_with?("\"")) || (password.start_with?("'") && password.end_with?("'")); password = password[1...-1]; end; password = CGI.escape(password); user = "contextqmd_registry"; host = "contextqmd_registry-db"; dbs = %w[contextqmd_registry_production contextqmd_registry_production_cache contextqmd_registry_production_queue contextqmd_registry_production_cable contextqmd_registry_production_analytics]; print dbs.map { |db| "postgres://#{user}:#{password}@#{host}/#{db}" }.join(",")')
